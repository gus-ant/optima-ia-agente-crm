# ============================================================
# Óptima IA — Agente Lara
# Arquivo de variáveis de ambiente — COPIE PARA .env
# NUNCA COMMITE O .env COM VALORES REAIS
# ============================================================

# --- Ambiente ---
ENV=development          # development | production
LOG_LEVEL=INFO
PORT=8000

# --- Multi-Tenant & Master ---
# Domínio base para resolução de subdomínio (ex: ludecor.optimaia.com.br)
BASE_DOMAIN=optimaia.com.br
# Ambiente: development desativa verificação de tenant obrigatório (facilita testes locais)
ENVIRONMENT=development  # development | production
# Chave de segurança para acessar o Painel Master e endpoints /api/master
MASTER_KEY=optima_master_secret_key

# --- LLM Gateway (por plano) ---
# basic  → gpt-3.5-turbo (sobrescrito pelo LLM_MODEL se definido)
# pro    → gpt-4o
# enterprise → configuração do AgentConfig no banco
LLM_MODEL=gpt-4o        # modelo global fallback
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...   # opcional se usar Claude

# --- WhatsApp ---
WHATSAPP_PROVIDER=uazapi   # uazapi | meta | evolution

# === UazAPI (RECOMENDADO) ===
# Obtenha em: https://app.uazapi.com
# Vantagens: Interface simples, melhor suporte, documentação clara
UAZAPI_API_KEY=
UAZAPI_INSTANCE_ID=

# === Meta Cloud API (Alternativa) ===
# Descomente se quiser usar Meta em vez de UazAPI
# Mude WHATSAPP_PROVIDER=meta acima
# META_PHONE_NUMBER_ID=
# META_ACCESS_TOKEN=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=optima_ia_verify_token_aqui

# === Evolution API - Self-hosted (Alternativa) ===
# Descomente se quiser usar Evolution em vez de UazAPI
# Mude WHATSAPP_PROVIDER=evolution acima
# EVOLUTION_API_URL=http://localhost:8080
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=lara

# --- CRM ---
CRM_PROVIDER=local       # local (outros foram removidos)

# Banco de Dados Relacional (CRM Próprio Local)
# Em produção: usar role optima_app (menor privilégio)
DATABASE_URL=postgresql+asyncpg://optima_app:troque_em_producao@db:5432/optimacrm
# Dev local com SQLite (sem Docker):
# DATABASE_URL=sqlite+aiosqlite:///./optimacrm.db

# --- Supabase (PostgreSQL gerenciado) ---
# Obtenha em: Project Settings → Database → Connection String → URI
#
# Opção A: Conexão Direta (porta 5432) — RECOMENDADO para dev e produção simples
# DATABASE_URL=postgresql+asyncpg://postgres:[SENHA]@db.[REF].supabase.co:5432/postgres
#
# Opção B: Transaction Pooler (porta 6543) — para alta escala (muitas conexões simultâneas)
# DATABASE_URL=postgresql+asyncpg://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres
#
# SSL e prepared statements são configurados automaticamente pelo crm/database.py
# ao detectar "supabase.co" na URL — nenhuma configuração extra necessária.
#
# Credenciais do SDK Supabase (opcional — para operações admin via supabase-py)
# Obtenha em: Project Settings → API
SUPABASE_URL=https://dybfceorsxfugajfrczf.supabase.co
SUPABASE_ANON_KEY=[ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[SERVICE_ROLE_KEY]

# --- Agendamento (v2.0) ---
# Integração com Google Calendar (opcional)
GOOGLE_CREDENTIALS_PATH=./google-credentials.json
GOOGLE_CALENDAR_ID=primary  # ou email do calendário

# --- Redis (persistência de sessão) ---
REDIS_URL=redis://localhost:6379

# --- Atendente humano (transbordo global padrão) ---
# Pode ser sobrescrito por AgentConfig.human_agent_whatsapp no banco
HUMAN_AGENT_WHATSAPP=5511999990000  # número do atendente (sem +)

# --- CORS ---
ALLOWED_ORIGINS=*

# --- N8N ---
N8N_ENCRYPTION_KEY=troque_em_producao
N8N_WEBHOOK_URL=http://localhost:5678

# --- Limites de custo LLM ---
# Configure no dashboard da OpenAI/Anthropic — não há controle via env aqui
